{
  "version": 1,
  "author": "CoCIS Smart Control and Monitoring System",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 20,
      "left": 20,
      "attrs": { "env": "esp-idf" }
    },
    {
      "type": "board-mfrc522",
      "id": "rfid_entry",
      "top": 45,
      "left": 360,
      "attrs": {}
    },
    {
      "type": "board-mfrc522",
      "id": "rfid_exit",
      "top": 175,
      "left": 360,
      "attrs": {}
    },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "room_pir",
      "top": 55,
      "left": 620,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": 45,
      "left": 830,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "door_relay",
      "top": 305,
      "left": 330,
      "attrs": { "transistor": "npn" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "light_relay",
      "top": 425,
      "left": 330,
      "attrs": { "transistor": "npn" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "exit_door_relay",
      "top": 545,
      "left": 330,
      "attrs": { "transistor": "npn" }
    },
    {
      "type": "wokwi-resistor",
      "id": "door_load_resistor",
      "top": 310,
      "left": 590,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "door_indicator",
      "top": 310,
      "left": 665,
      "attrs": { "color": "red", "label": "Entry door" }
    },
    {
      "type": "wokwi-resistor",
      "id": "light_load_resistor",
      "top": 430,
      "left": 590,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "room_light",
      "top": 430,
      "left": 665,
      "attrs": { "color": "yellow", "label": "Room light" }
    },
    {
      "type": "wokwi-resistor",
      "id": "exit_load_resistor",
      "top": 550,
      "left": 590,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "exit_indicator",
      "top": 550,
      "left": 665,
      "attrs": { "color": "green", "label": "Exit door" }
    }
  ],
  "connections": [
    [ "esp:D18", "rfid_entry:SCK", "green", [] ],
    [ "esp:D23", "rfid_entry:MOSI", "green", [] ],
    [ "esp:D19", "rfid_entry:MISO", "green", [] ],
    [ "esp:D5", "rfid_entry:SDA", "green", [] ],
    [ "esp:D22", "rfid_entry:RST", "green", [] ],
    [ "esp:3V3", "rfid_entry:3.3V", "red", [] ],
    [ "esp:GND.1", "rfid_entry:GND", "black", [] ],

    [ "esp:D18", "rfid_exit:SCK", "green", [] ],
    [ "esp:D23", "rfid_exit:MOSI", "green", [] ],
    [ "esp:D19", "rfid_exit:MISO", "green", [] ],
    [ "esp:D4", "rfid_exit:SDA", "green", [] ],
    [ "esp:D13", "rfid_exit:RST", "green", [] ],
    [ "esp:3V3", "rfid_exit:3.3V", "red", [] ],
    [ "esp:GND.2", "rfid_exit:GND", "black", [] ],

    [ "esp:D21", "oled:SDA", "blue", [] ],
    [ "esp:D25", "oled:SCL", "yellow", [] ],
    [ "esp:3V3", "oled:VCC", "red", [] ],
    [ "esp:GND.1", "oled:GND", "black", [] ],

    [ "esp:VIN", "room_pir:VCC", "red", [] ],
    [ "esp:D32", "room_pir:OUT", "green", [] ],
    [ "esp:GND.1", "room_pir:GND", "black", [] ],

    [ "esp:D26", "door_relay:IN", "blue", [] ],
    [ "esp:D27", "light_relay:IN", "blue", [] ],
    [ "esp:D33", "exit_door_relay:IN", "blue", [] ],
    [ "esp:VIN", "door_relay:VCC", "red", [] ],
    [ "esp:VIN", "light_relay:VCC", "red", [] ],
    [ "esp:VIN", "exit_door_relay:VCC", "red", [] ],
    [ "esp:GND.2", "door_relay:GND", "black", [] ],
    [ "esp:GND.2", "light_relay:GND", "black", [] ],
    [ "esp:GND.2", "exit_door_relay:GND", "black", [] ],

    [ "esp:VIN", "door_relay:COM", "red", [] ],
    [ "door_relay:NO", "door_load_resistor:1", "orange", [] ],
    [ "door_load_resistor:2", "door_indicator:A", "orange", [] ],
    [ "door_indicator:C", "esp:GND.2", "black", [] ],

    [ "esp:VIN", "light_relay:COM", "red", [] ],
    [ "light_relay:NO", "light_load_resistor:1", "orange", [] ],
    [ "light_load_resistor:2", "room_light:A", "orange", [] ],
    [ "room_light:C", "esp:GND.2", "black", [] ],

    [ "esp:VIN", "exit_door_relay:COM", "red", [] ],
    [ "exit_door_relay:NO", "exit_load_resistor:1", "orange", [] ],
    [ "exit_load_resistor:2", "exit_indicator:A", "orange", [] ],
    [ "exit_indicator:C", "esp:GND.2", "black", [] ]
  ],
  "serialMonitor": { "display": "auto", "newline": "lf" }
}
